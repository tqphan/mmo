<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The parts of the client with no Godot dependency (docs/design/client.md §4). -->
    <Compile Include="../src/Sim/*.cs" Link="Client/Sim/%(Filename)%(Extension)" />
    <Compile Include="../src/Net/SubscriptionDirector.cs" Link="Client/Net/SubscriptionDirector.cs" />
    <Compile Include="../src/World/SnapshotBuffer.cs" Link="Client/World/SnapshotBuffer.cs" />
    <Compile Include="../src/World/HeightMap.cs" Link="Client/World/HeightMap.cs" />
    <Compile Include="../src/World/LandRaster.cs" Link="Client/World/LandRaster.cs" />
    <Compile Include="../src/World/WorldFiles.cs" Link="Client/World/WorldFiles.cs" />
    <Compile Include="../src/World/TerrainPlan.cs" Link="Client/World/TerrainPlan.cs" />
    <Compile Include="../src/Gameplay/MoveSender.cs" Link="Client/Gameplay/MoveSender.cs" />
    <Compile Include="../src/Gameplay/Autopilot.cs" Link="Client/Gameplay/Autopilot.cs" />
    <Compile Include="../src/Gameplay/Boarding.cs" Link="Client/Gameplay/Boarding.cs" />
    <Compile Include="../src/Gameplay/Swimming.cs" Link="Client/Gameplay/Swimming.cs" />
    <Compile Include="../src/Gameplay/BagModel.cs" Link="Client/Gameplay/BagModel.cs" />
    <Compile Include="../src/Gameplay/CraftModel.cs" Link="Client/Gameplay/CraftModel.cs" />
    <Compile Include="../src/World/ShipPredictor.cs" Link="Client/World/ShipPredictor.cs" />
    <Compile Include="../content/*.cs" Link="Client/Content/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="vectors/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
